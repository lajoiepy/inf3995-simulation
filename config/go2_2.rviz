Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 100; 100; 100
      Alpha: 0.3
    - Class: rviz_default_plugins/Axes
      Name: Robot position
      Enabled: true
      Reference Frame: go2_2/base
      Length: 0.5
      Radius: 0.03
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /go2_2/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 0; 255; 100
      Decay Time: 0
      Queue Size: 10
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /go2_2/camera/image
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Transport Hint: raw
  Enabled: true
  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: go2_2/base
      Scale: 35
      Angle: 0
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Width: 1280
  Height: 850
  X: 40
  Y: 40
